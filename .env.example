# ResTix environment variables. Copy to .env.local for local development.
# Placeholders only. Never commit real values.

# --- Database -----------------------------------------------------------------
# Local: the PGlite server started by `npm run db` (port 54329).
# Production: Supabase's connection pooler (Settings > Database > Connection string >
# Transaction pooler, port 6543). Use the `postgres` user's password.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
DB_POOL_MAX=5

# Public origin of the app, used for OAuth redirects and metadata. No trailing slash.
APP_URL=http://localhost:3000

# --- Institutional sign-in ----------------------------------------------------
# The ONE authoritative allowlist: comma-separated email domains allowed to sign in.
# Exact match only (subdomains and lookalikes are rejected).
# VERIFY the real domain with the institution before deploying.
ALLOWED_EMAIL_DOMAINS=snu.edu.in
# Which college the public landing page shows (a slug from restix.colleges).
DEFAULT_COLLEGE_SLUG=snu

# --- Authentication -----------------------------------------------------------
# supabase = Google sign-in through Supabase Auth (production).
# dev      = local development sign-in; refused in production builds and on Vercel.
AUTH_MODE=dev
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Only for AUTH_MODE=dev. Any random string of 32+ characters.
DEV_AUTH_SECRET=replace-with-32-plus-random-characters

# --- Operations ---------------------------------------------------------------
# Shared secret for /api/cron/maintenance (Vercel Cron sends it as a Bearer token). 16+ chars.
CRON_SECRET=replace-with-a-long-random-string

# Local only: allow dev sign-in on a local `next start` (used by the E2E tests). Never set in production.
# RESTIX_LOCAL_PROD_TEST=1
